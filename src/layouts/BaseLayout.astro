---
import '../styles/global.css';
import { site } from '../config/site';
import { getImage } from 'astro:assets';
import { heroImage } from '../data/gallery';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${site.siteName} | Detalles personalizados para eventos`, description = site.siteDescription } = Astro.props;
const canonical = site.siteUrl ? new URL(Astro.url.pathname, site.siteUrl).href : undefined;
// 1200×630 es el formato recomendado para vistas previas (WhatsApp, Facebook); calidad 75 lo mantiene ligero.
const OG_WIDTH = 1200;
const OG_HEIGHT = 630;
const ogImage = await getImage({
  src: heroImage.src,
  width: OG_WIDTH,
  height: OG_HEIGHT,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
  quality: 75,
});
const ogImageUrl = site.siteUrl ? new URL(ogImage.src, site.siteUrl).href : undefined;

const { business } = site;
const jsonLd = site.siteUrl
  ? {
      '@context': 'https://schema.org',
      '@type': 'ShoeStore',
      '@id': `${site.siteUrl}/#negocio`,
      name: site.siteName,
      description: site.siteDescription,
      url: site.siteUrl,
      image: ogImageUrl,
      telephone: business.telephone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: `${business.streetAddress}, ${business.neighborhood}`,
        postalCode: business.postalCode,
        addressLocality: business.locality,
        addressRegion: business.region,
        addressCountry: business.country,
      },
      areaServed: business.areaServed,
      sameAs: [site.facebookUrl],
    }
  : null;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F8F5EF" />
    <script is:inline>
      try {
        const raw = localStorage.getItem('sandypant-a11y');
        if (raw) {
          const s = JSON.parse(raw);
          const root = document.documentElement;
          if (typeof s.fontStep === 'number' && s.fontStep !== 0) {
            const step = Math.max(-2, Math.min(3, s.fontStep));
            root.style.fontSize = `${100 + step * 10}%`;
          }
          if (s.dark) root.setAttribute('data-a11y-dark', '');
          if (s.grayscale) root.setAttribute('data-a11y-grayscale', '');
          if (s.negative) root.setAttribute('data-a11y-negative', '');
          if (s.underline) root.setAttribute('data-a11y-underline', '');
          if (s.readableFont) root.setAttribute('data-a11y-readable-font', '');
          const cs = document.querySelector('meta[name="color-scheme"]');
          if (cs && (s.dark || s.negative)) cs.setAttribute('content', 'dark');
        }
      } catch {}
    </script>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={site.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(OG_WIDTH)} />
        <meta property="og:image:height" content={String(OG_HEIGHT)} />
        <meta property="og:image:alt" content={heroImage.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-white focus:px-4 focus:py-2">
      Saltar al contenido
    </a>
    <slot />
    <script>
      // Control global de skeletons de carga en contenedores de imagen
      document.querySelectorAll<HTMLElement>('.skeleton-wrapper').forEach((wrapper) => {
        const img = wrapper.querySelector<HTMLImageElement>('img');
        if (!img) {
          wrapper.classList.add('is-loaded');
          return;
        }
        const markLoaded = () => wrapper.classList.add('is-loaded');
        // complete=true también cuando la carga ya falló: no dejar el skeleton girando para siempre.
        if (img.complete) {
          markLoaded();
        } else {
          img.addEventListener('load', markLoaded, { once: true });
          img.addEventListener('error', markLoaded, { once: true });
        }
      });
    </script>
  </body>
</html>
