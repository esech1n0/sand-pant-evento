---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';
import logo from '../assets/images/logo-a-tus-pies.png';
import { site, navLinks } from '../config/site';
---

<header class="sticky top-0 z-40 border-b border-sand/70 bg-ivory/95 backdrop-blur-sm">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="#inicio" class="brand-logo shrink-0" draggable="false" aria-label={`${site.siteName}, ir al inicio`}>
      <Image
        src={logo}
        alt={site.siteName}
        width={128}
        densities={[1, 2]}
        loading="eager"
        decoding="async"
        draggable="false"
        class="h-auto w-[112px] sm:w-[128px]"
      />
    </a>

    <nav aria-label="Principal" class="nav-scrollspy hidden md:block">
      <ul class="nav-list relative flex items-center gap-7 text-sm">
        {navLinks.map((link, i) => (
          <li class:list={['nav-item', { active: i === 0 }]}>
            <a
              href={link.href}
              data-nav-link={link.href.slice(1)}
              aria-current={i === 0 ? 'location' : undefined}
              class:list={['nav-link relative inline-block py-1.5', { 'target-current': i === 0 }]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex size-11 cursor-pointer items-center justify-center rounded-full text-espresso hover:bg-sand/50 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Menu size={22} aria-hidden="true" class="icon-open" />
      <X size={22} aria-hidden="true" class="icon-close hidden" />
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Principal móvil" class="nav-scrollspy hidden border-t border-sand/70 bg-ivory md:hidden">
    <ul class="container-page flex flex-col py-3">
      {navLinks.map((link, i) => (
        <li class:list={['nav-item-mobile', { active: i === 0 }]}>
          <a
            href={link.href}
            data-nav-link={link.href.slice(1)}
            aria-current={i === 0 ? 'location' : undefined}
            class:list={['nav-link nav-link-mobile relative inline-block py-2.5 text-base', { 'target-current': i === 0 }]}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      menu.classList.toggle('hidden', !open);
      toggle.querySelector('.icon-open')?.classList.toggle('hidden', open);
      toggle.querySelector('.icon-close')?.classList.toggle('hidden', !open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }

  // Resaltado activo fluido de sección en navegación al avanzar o regresar por la página
  const navAnchors = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]'));
  const sectionIds = Array.from(new Set(navAnchors.map((a) => a.dataset.navLink).filter(Boolean))) as string[];
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0 && navAnchors.length > 0) {
    let activeId = sections[0].id;
    let lockedId: string | null = null;
    let lockTimeout: number | undefined;

    const setActive = (id: string) => {
      activeId = id;
      navAnchors.forEach((a) => {
        const isActive = a.dataset.navLink === id;
        a.classList.toggle('target-current', isActive);
        a.closest('li')?.classList.toggle('active', isActive);
        if (isActive) {
          a.setAttribute('aria-current', 'location');
        } else {
          a.removeAttribute('aria-current');
        }
      });
    };

    const detectSection = () => {
      if (lockedId) return;
      const vh = window.innerHeight;
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - vh;

      if (scrollY <= 30) {
        if (activeId !== sections[0].id) setActive(sections[0].id);
        return;
      }

      if (maxScroll > 0 && scrollY >= maxScroll - 40) {
        const lastId = sections[sections.length - 1].id;
        if (activeId !== lastId) setActive(lastId);
        return;
      }

      const triggerLine = vh * 0.42;
      let current = sections[0].id;
      for (const sec of sections) {
        const rect = sec.getBoundingClientRect();
        if (rect.top <= triggerLine) {
          current = sec.id;
        } else {
          break;
        }
      }
      if (current !== activeId) {
        setActive(current);
      }
    };

    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            detectSection();
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    document.addEventListener('scrollend', () => {
      lockedId = null;
      detectSection();
    });

    window.addEventListener('resize', detectSection, { passive: true });

    navAnchors.forEach((a) => {
      a.addEventListener('click', () => {
        const targetId = a.dataset.navLink;
        if (!targetId) return;
        lockedId = targetId;
        setActive(targetId);
        window.clearTimeout(lockTimeout);
        lockTimeout = window.setTimeout(() => {
          lockedId = null;
        }, 750);
      });
    });

    detectSection();
  }
</script>
