---
import { site, navLinks } from '../config/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const year = new Date().getFullYear(); // Año de la compilación
const whatsappUrl = buildWhatsAppUrl('general');
const { business } = site;
const addressLine = `${business.streetAddress}, ${business.neighborhood}, ${business.postalCode} ${business.locality}, ${business.region}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;
---

<footer class="border-t border-sand/70 bg-ivory py-12">
  <div class="container-page flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
    <div>
      <p class="font-serif text-xl font-semibold text-espresso">{site.siteName}</p>
      <p class="mt-2 max-w-xs text-sm text-muted">Detalles personalizados para momentos especiales.</p>
      <address class="mt-4 max-w-xs text-sm not-italic text-muted">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-espresso hover:underline">
          {business.streetAddress}, {business.neighborhood},<br />
          {business.postalCode} {business.locality}, {business.region}
          <span class="sr-only"> (ver en Google Maps, abre en una pestaña nueva)</span>
        </a>
      </address>
    </div>
    <nav aria-label="Secundaria">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm">
        {navLinks.map((link) => (
          <li><a href={link.href} class="text-muted hover:text-espresso">{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <ul class="flex flex-col gap-3 text-sm">
      {whatsappUrl && (
        <li><a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="text-espresso underline-offset-4 hover:underline">Escríbenos por WhatsApp</a></li>
      )}
      <li><a href={site.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-espresso underline-offset-4 hover:underline">Facebook<span class="sr-only"> (abre en una pestaña nueva)</span></a></li>
    </ul>
  </div>
  <div class="container-page mt-10 border-t border-sand/70 pt-6 text-xs text-muted">
    © {year} {site.siteName}
  </div>
</footer>
