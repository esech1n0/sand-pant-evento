---
import { Picture } from 'astro:assets';
import WhatsAppLink from './WhatsAppLink.astro';
import { heroImage } from '../data/gallery';
---

<section id="inicio" class="container-page grid items-center gap-10 py-10 md:grid-cols-[1fr_1.05fr] md:gap-14 md:py-20">
  <div class="order-2 md:order-1">
    <p class="eyebrow">Detalles para momentos especiales</p>
    <h1 class="mt-5 font-serif font-medium leading-[1.05] text-espresso" style="font-size: clamp(2.5rem, 1.6rem + 4vw, 4.5rem);">
      Cada celebración merece un detalle único.
    </h1>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
      Sandalias y pantuflas personalizadas para acompañar tus momentos más especiales.
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <WhatsAppLink id="hero-whatsapp" />
      <a href="#galeria" class="btn btn-outline">Ver trabajos</a>
    </div>
  </div>

  <div class="order-1 md:order-2">
    <Picture
      src={heroImage.src}
      alt={heroImage.alt}
      formats={['avif', 'webp']}
      widths={[480, 768, 1080]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-sm object-cover shadow-[0_20px_50px_-25px_rgba(48,42,38,0.45)]"
    />
  </div>
</section>
