---
import { Image, getImage } from 'astro:assets';
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { galleryItems, visibleGalleryCategories, fitWidths, LIGHTBOX_WIDTH } from '../data/gallery';

// Versión ampliada optimizada (no se sirve el original).
const items = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    large: await getImage({
      src: item.src,
      width: Math.min(LIGHTBOX_WIDTH, item.src.width),
      format: 'webp',
      quality: 75,
    }),
  })),
);
---

<section id="galeria" class="border-t border-sand/70 bg-white py-20 md:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Galería</p>
      <h2 class="heading-section mt-4">Trabajos realizados</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Algunos de los detalles que hemos preparado para distintas celebraciones.
      </p>
    </div>

    <!-- Los filtros se muestran solo cuando JavaScript está disponible. -->
    <div id="gallery-filters" role="group" aria-label="Filtrar trabajos por tipo de evento" class="mt-10 hidden flex-wrap gap-2">
      {visibleGalleryCategories.map((cat, i) => (
        <button
          type="button"
          data-filter={cat.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="filter-btn min-h-11 cursor-pointer rounded-full border border-espresso/25 px-5 text-sm text-espresso transition-colors hover:border-espresso aria-pressed:border-espresso aria-pressed:bg-espresso aria-pressed:text-ivory"
        >
          {cat.label}
        </button>
      ))}
    </div>

    <p id="gallery-status" class="sr-only" aria-live="polite"></p>

    <ul id="gallery-grid" class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {items.map((item, index) => (
        <li data-categories={item.categories.join(' ')} data-index={index}>
          <a
            href={item.large.src}
            class="gallery-link lightbox-trigger skeleton-wrapper group relative block cursor-pointer overflow-hidden rounded-sm bg-sand/40"
            data-lightbox-group="galeria"
            data-large={item.large.src}
            data-alt={item.alt}
            aria-label={`Ampliar: ${item.alt}`}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={fitWidths(item.src, [320, 480, 640])}
              sizes="(min-width: 1024px) 25vw, 50vw"
              loading="lazy"
              class="pop-photo aspect-[4/5] w-full cursor-pointer object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            />
          </a>
        </li>
      ))}
    </ul>

    <div id="gallery-empty" class="mt-8 hidden rounded-sm border border-dashed border-sand p-10 text-center">
      <p class="font-serif text-2xl text-espresso">Aún no hay fotografías en esta categoría.</p>
      <p class="mt-2 text-muted">Escríbenos y con gusto conversamos sobre tu evento.</p>
    </div>

    <div class="mt-12 flex justify-center">
      <WhatsAppLink message="gallery" label="Me interesa un trabajo así" />
    </div>
  </div>
</section>

<dialog
  id="lightbox"
  aria-label="Visor de imágenes"
  class="m-auto max-h-none max-w-none bg-transparent p-0"
>
  <div class="relative flex h-dvh w-screen items-center justify-center p-4 sm:p-12">
    <div
      id="lightbox-skeleton"
      aria-hidden="true"
      class="skeleton-box aspect-[4/5] h-[72dvh] max-w-[85vw] rounded-sm"
    ></div>
    <img id="lightbox-img" alt="" class="lightbox-pop-img hidden max-h-[85dvh] max-w-full rounded-sm object-contain" />
    <p id="lightbox-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-[#f8f5ef]" aria-live="polite"></p>
    <button type="button" data-action="close" class="lb-btn absolute right-3 top-3 cursor-pointer" aria-label="Cerrar visor">
      <X size={24} aria-hidden="true" />
    </button>
    <button type="button" data-action="prev" class="lb-btn absolute left-2 top-1/2 -translate-y-1/2 cursor-pointer sm:left-4" aria-label="Imagen anterior">
      <ChevronLeft size={26} aria-hidden="true" />
    </button>
    <button type="button" data-action="next" class="lb-btn absolute right-2 top-1/2 -translate-y-1/2 cursor-pointer sm:right-4" aria-label="Imagen siguiente">
      <ChevronRight size={26} aria-hidden="true" />
    </button>
  </div>
</dialog>

<style>
  @reference "../styles/global.css";
  .lb-btn {
    @apply inline-flex size-12 items-center justify-center rounded-full bg-ivory/90 text-espresso transition-colors hover:bg-white;
  }
  .lb-btn:focus-visible {
    outline-color: #f8f5ef;
  }
</style>

<script>
  const filters = document.getElementById('gallery-filters');
  const grid = document.getElementById('gallery-grid');
  const empty = document.getElementById('gallery-empty');
  const status = document.getElementById('gallery-status');
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lbSkeleton = document.getElementById('lightbox-skeleton');
  const counter = document.getElementById('lightbox-counter');

  // Animación 'pop' al aparecer para todas las fotos de Productos y Galería (excepto la foto de Inicio)
  const popPhotos = Array.from(document.querySelectorAll<HTMLElement>('.pop-photo'));
  const triggerPop = (el: HTMLElement, delayMs = 0) => {
    el.classList.remove('is-popped');
    el.style.animationDelay = delayMs > 0 ? `${delayMs}ms` : '0ms';
    void el.offsetWidth;
    el.classList.add('is-popped');
  };

  if ('IntersectionObserver' in window && popPhotos.length > 0) {
    popPhotos.forEach((img) => img.classList.add('pop-ready'));
    const popObserver = new IntersectionObserver(
      (entries, obs) => {
        let batchIndex = 0;
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            triggerPop(el, batchIndex * 55);
            batchIndex++;
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.12 },
    );
    popPhotos.forEach((img) => popObserver.observe(img));
  }

  if (filters && grid && empty && status) {
    const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    filters.classList.remove('hidden');
    filters.classList.add('flex');

    // Filtros
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'todos';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let visible = 0;
        items.forEach((li) => {
          const show = filter === 'todos' || (li.dataset.categories ?? '').split(' ').includes(filter);
          li.hidden = !show;
          if (show) {
            const photo = li.querySelector<HTMLElement>('.pop-photo');
            if (photo) {
              photo.classList.add('pop-ready');
              triggerPop(photo, visible * 45);
            }
            visible++;
          }
        });
        empty.classList.toggle('hidden', visible > 0);
        status.textContent = `${btn.textContent?.trim()}: ${visible} ${visible === 1 ? 'fotografía' : 'fotografías'}`;
      });
    });
  }

  // Visor compartido para Productos y Galería con skeleton de carga y animación 'pop'
  if (dialog && lbImg && counter) {
    let currentLinks: HTMLAnchorElement[] = [];
    let position = 0;
    let loadToken = 0;

    let supportsDisplayTransition: boolean | undefined;
    const canTransitionDisplay = () => {
      if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
      if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
        return false;
      }
      const probe = document.createElement('div');
      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
      document.body.appendChild(probe);
      getComputedStyle(probe).display;
      probe.style.display = 'none';
      supportsDisplayTransition = getComputedStyle(probe).display === 'block';
      probe.remove();
      return supportsDisplayTransition;
    };

    const supportsTopLayerExit = () =>
      Boolean(window.CSS?.supports?.('overlay', 'auto')) && canTransitionDisplay();

    const closeTopLayer = async (el: HTMLDialogElement) => {
      if (!supportsTopLayerExit()) {
        el.setAttribute('data-closing', '');
        const animations = el.getAnimations({ subtree: true });
        if (animations.length > 0) {
          await Promise.race([
            Promise.allSettled(animations.map((a) => a.finished)),
            new Promise((r) => setTimeout(r, 400)),
          ]);
        }
        if (!el.hasAttribute('data-closing')) return;
        el.removeAttribute('data-closing');
      }
      el.close();
    };

    const revealLightboxImage = () => {
      lbSkeleton?.classList.add('hidden');
      lbImg.classList.remove('hidden', 'is-popping');
      void lbImg.offsetWidth;
      lbImg.classList.add('is-popping');
    };

    const show = (i: number) => {
      if (currentLinks.length === 0) return;
      position = (i + currentLinks.length) % currentLinks.length;
      const link = currentLinks[position];
      const nextSrc = link.dataset.large ?? '';
      const nextAlt = link.dataset.alt ?? '';
      const token = ++loadToken;

      counter.textContent = `${position + 1} de ${currentLinks.length}`;

      // Mostrar skeleton mientras se carga la imagen ampliada
      lbImg.classList.add('hidden');
      lbImg.classList.remove('is-popping');
      lbSkeleton?.classList.remove('hidden');

      lbImg.onload = () => {
        if (token !== loadToken) return;
        revealLightboxImage();
      };
      lbImg.onerror = () => {
        if (token !== loadToken) return;
        revealLightboxImage();
      };

      lbImg.alt = nextAlt;
      lbImg.src = nextSrc;

      if (lbImg.complete && lbImg.naturalWidth > 0) {
        revealLightboxImage();
      }
    };

    document.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.lightbox-trigger');
      if (!link) return;
      e.preventDefault();

      const group = link.dataset.lightboxGroup ?? 'galeria';
      const allInGroup = Array.from(
        document.querySelectorAll<HTMLAnchorElement>(`.lightbox-trigger[data-lightbox-group="${group}"]`),
      );
      currentLinks = allInGroup.filter((a) => {
        const li = a.closest('li');
        return !li || !li.hidden;
      });

      const idx = currentLinks.indexOf(link);
      show(idx >= 0 ? idx : 0);

      const single = currentLinks.length < 2;
      dialog
        .querySelectorAll<HTMLButtonElement>('[data-action="prev"],[data-action="next"]')
        .forEach((b) => (b.hidden = single));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLButtonElement>('[data-action]')?.dataset.action;
      if (action === 'close' || target === dialog || target === dialog.firstElementChild) {
        void closeTopLayer(dialog);
      } else if (action === 'prev') {
        show(position - 1);
      } else if (action === 'next') {
        show(position + 1);
      }
    });

    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      void closeTopLayer(dialog);
    });

    dialog.addEventListener('keydown', (e) => {
      if (currentLinks.length < 2) return;
      if (e.key === 'ArrowLeft') show(position - 1);
      if (e.key === 'ArrowRight') show(position + 1);
    });
  }
</script>
