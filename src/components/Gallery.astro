---
import { Image, getImage } from 'astro:assets';
import { ChevronLeft, ChevronRight, X } from '@lucide/astro';
import WhatsAppLink from './WhatsAppLink.astro';
import { galleryItems, galleryCategories } from '../data/gallery';

// Versión ampliada optimizada (no se sirve el original).
const items = await Promise.all(
  galleryItems.map(async (item) => ({
    ...item,
    large: await getImage({ src: item.src, width: 1600, format: 'webp' }),
  })),
);
---

<section id="galeria" class="border-t border-sand/70 bg-white py-20 md:py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">Galería</p>
      <h2 class="heading-section mt-4">Trabajos realizados</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Algunos de los detalles que hemos preparado para distintas celebraciones.
      </p>
    </div>

    <!-- Los filtros se muestran solo cuando JavaScript está disponible. -->
    <div id="gallery-filters" role="group" aria-label="Filtrar trabajos por tipo de evento" class="mt-10 hidden flex-wrap gap-2">
      {galleryCategories.map((cat, i) => (
        <button
          type="button"
          data-filter={cat.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="filter-btn min-h-11 rounded-full border border-espresso/25 px-5 text-sm text-espresso transition-colors hover:border-espresso aria-pressed:border-espresso aria-pressed:bg-espresso aria-pressed:text-ivory"
        >
          {cat.label}
        </button>
      ))}
    </div>

    <p id="gallery-status" class="sr-only" aria-live="polite"></p>

    <ul id="gallery-grid" class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {items.map((item, index) => (
        <li data-categories={item.categories.join(' ')} data-index={index}>
          <a
            href={item.large.src}
            class="gallery-link group block overflow-hidden rounded-sm bg-sand/40"
            data-large={item.large.src}
            data-alt={item.alt}
            aria-label={`Ampliar: ${item.alt}`}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[320, 480, 640]}
              sizes="(min-width: 1024px) 25vw, 50vw"
              loading="lazy"
              class="aspect-[4/5] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
            />
          </a>
        </li>
      ))}
    </ul>

    <div id="gallery-empty" class="mt-8 hidden rounded-sm border border-dashed border-sand p-10 text-center">
      <p class="font-serif text-2xl text-espresso">Aún no hay fotografías en esta categoría.</p>
      <p class="mt-2 text-muted">Escríbenos y con gusto conversamos sobre tu evento.</p>
    </div>

    <div class="mt-12 flex justify-center">
      <WhatsAppLink message="gallery" label="Me interesa un trabajo así" />
    </div>
  </div>

  <dialog
    id="lightbox"
    aria-label="Visor de imágenes"
    class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-espresso/90"
  >
    <div class="relative flex h-dvh w-screen items-center justify-center p-4 sm:p-12">
      <img id="lightbox-img" src="" alt="" class="max-h-[85dvh] max-w-full rounded-sm object-contain" />
      <p id="lightbox-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-ivory" aria-live="polite"></p>
      <button type="button" data-action="close" class="lb-btn absolute right-3 top-3" aria-label="Cerrar visor">
        <X size={24} aria-hidden="true" />
      </button>
      <button type="button" data-action="prev" class="lb-btn absolute left-2 top-1/2 -translate-y-1/2 sm:left-4" aria-label="Imagen anterior">
        <ChevronLeft size={26} aria-hidden="true" />
      </button>
      <button type="button" data-action="next" class="lb-btn absolute right-2 top-1/2 -translate-y-1/2 sm:right-4" aria-label="Imagen siguiente">
        <ChevronRight size={26} aria-hidden="true" />
      </button>
    </div>
  </dialog>
</section>

<style>
  @reference "../styles/global.css";
  .lb-btn {
    @apply inline-flex size-12 items-center justify-center rounded-full bg-ivory/90 text-espresso transition-colors hover:bg-white;
  }
  .lb-btn:focus-visible {
    outline-color: var(--color-ivory);
  }
</style>

<script>
  const filters = document.getElementById('gallery-filters');
  const grid = document.getElementById('gallery-grid');
  const empty = document.getElementById('gallery-empty');
  const status = document.getElementById('gallery-status');
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const counter = document.getElementById('lightbox-counter');

  if (filters && grid && empty && status && dialog && lbImg && counter) {
    const items = Array.from(grid.querySelectorAll<HTMLLIElement>('li'));
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    filters.classList.remove('hidden');
    filters.classList.add('flex');

    // Filtros
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'todos';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        let visible = 0;
        items.forEach((li) => {
          const show = filter === 'todos' || (li.dataset.categories ?? '').split(' ').includes(filter);
          li.hidden = !show;
          if (show) visible++;
        });
        empty.classList.toggle('hidden', visible > 0);
        status.textContent = `${btn.textContent?.trim()}: ${visible} ${visible === 1 ? 'fotografía' : 'fotografías'}`;
      });
    });

    // Visor
    let current: HTMLLIElement[] = [];
    let position = 0;
    let trigger: HTMLElement | null = null;

    const show = (i: number) => {
      position = (i + current.length) % current.length;
      const link = current[position].querySelector<HTMLAnchorElement>('.gallery-link');
      if (!link) return;
      lbImg.src = link.dataset.large ?? '';
      lbImg.alt = link.dataset.alt ?? '';
      counter.textContent = `${position + 1} de ${current.length}`;
    };

    grid.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.gallery-link');
      if (!link) return;
      e.preventDefault();
      current = items.filter((li) => !li.hidden);
      trigger = link;
      show(current.indexOf(link.closest('li') as HTMLLIElement));
      const single = current.length < 2;
      dialog.querySelectorAll<HTMLButtonElement>('[data-action="prev"],[data-action="next"]').forEach((b) => (b.hidden = single));
      dialog.showModal();
    });

    dialog.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.closest<HTMLButtonElement>('[data-action]')?.dataset.action;
      if (action === 'close' || target === dialog || target === dialog.firstElementChild) dialog.close();
      else if (action === 'prev') show(position - 1);
      else if (action === 'next') show(position + 1);
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(position - 1);
      if (e.key === 'ArrowRight') show(position + 1);
    });

    dialog.addEventListener('close', () => trigger?.focus());
  }
</script>
